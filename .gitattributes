# 设置全局行尾符
# Git会在Windows上转换为CRLF，在Linux/macOS上转换为LF

# 文本文件
* text=auto
*.md text=auto
*.js text=auto
*.json text=auto
*.sh text eol=lf
*.bat text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary

# 特殊文件
package.json text eol=lf
*.config.js text eol=lf
core-scheduler.js text eol=lf
auth-agent-core.js text eol=lf

# 确保行尾一致性
* text=auto eol=lf