# 通神认证Agent 环境变量配置
# 复制此文件为 .env 并填入实际值

# === 基础配置 ===
# 是否启用通神认证Agent
TONGSHEN_AGENT_ENABLED=true

# 通神Agent工作目录
TONGSHEN_AGENT_PATH=C:\Users\Administrator\Desktop\通神兵器库

# 技能文件路径
TONGSHEN_SKILLS_PATH=D:\WorkBuddy

# === 进化系统配置 ===
# 是否启用自优化进化
TONGSHEN_EVOLUTION_ENABLED=true

# 进化间隔（毫秒），默认60秒
TONGSHEN_EVOLUTION_INTERVAL=60000

# 最大进化代数
TONGSHEN_MAX_GENERATIONS=100

# === MCP服务器配置 ===
# Firecrawl API密钥
MCP_FIRECRAWL_KEY=fc-7f6c51167e4d4c4abe925b8d179ae30d

# GitHub个人访问令牌
MCP_GITHUB_TOKEN=ghp_YOUR_TOKEN_PLACEHOLDER

# GitHub访问令牌过期日期（YYYY-MM-DD）
MCP_GITHUB_EXPIRES=2027-06-15

# === 服务器配置 ===
# Web服务端口
PORT=3000

# 是否启用HTTPS
HTTPS_ENABLED=false

# === 日志配置 ===
# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 日志文件路径
LOG_PATH=logs

# 是否启用日志轮转
LOG_ROTATION=true

# === 性能配置 ===
# 最大内存使用（MB）
MAX_MEMORY_MB=500

# 最大CPU使用率（%）
MAX_CPU_PERCENT=20

# 任务超时时间（毫秒）
TASK_TIMEOUT_MS=10000

# === 缓存配置 ===
# 是否启用缓存
CACHE_ENABLED=true

# 缓存TTL（秒）
CACHE_TTL=3600

# 最大缓存数量
CACHE_MAX_SIZE=100

# === 数据库配置 ===
# SQLite数据库路径
SQLITE_PATH=C:\Users\Administrator\workspace\trading.db

# === 安全配置 ===
# JWT密钥
JWT_SECRET=your-jwt-secret-key-here

# API密钥
API_KEY=your-api-key-here

# 是否启用认证
AUTH_ENABLED=false

# === 开发配置 ===
# 是否开发模式
NODE_ENV=production

# 是否启用调试模式
DEBUG_MODE=false

# 是否启用详细日志
VERBOSE_LOGGING=false